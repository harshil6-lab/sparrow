# Sparrow frontend environment
#
# Run against the in-browser mock providers (auth + profile in localStorage).
# No AWS/Cognito wiring yet — flip this to "false" only once infra is ready.
VITE_USE_MOCK=true

# Optional hosted story video URL. Leave empty to use the five illustrated
# fallback frames (the app also falls back automatically on any video error).
VITE_STORY_URL=

# Solar tab. Off by default (four tabs: Home, Missions, Learn, Me). Set to
# "true" to re-enable the Solar route. The Solar code path stays in place.
VITE_FEATURE_SOLAR=false

# Optional hosted Learn clip. Leave empty and the clip sheet shows "Coming soon".
VITE_LEARN_CLIP_URL=

# ---------------------------------------------------------------------------
# Real backend (used when VITE_USE_MOCK=false). Everything below is a PUBLIC
# identifier, never a secret. See docs/DEPLOY_BACKEND.md for the live values.
# ---------------------------------------------------------------------------

# HTTP API base URL, no trailing slash.
VITE_API_URL=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com

# Cognito User Pool (SPA client, no secret).
VITE_COGNITO_REGION=ap-south-1
VITE_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=your-prefix.auth.ap-south-1.amazoncognito.com

# Show the "Continue with Google" button. Only enable once the Google identity
# provider is configured on the User Pool.
VITE_COGNITO_GOOGLE=false
